@startuml
!include ../_template_styles.puml

participant "Core 1" as C1
participant "Core 2" as C2
participant "I/O wait" as IO

== Parallelism ==
C1 -> C1 : Task A
C2 -> C2 : Task B

== Concurrency ==
C1 -> IO : start request
IO --> C1 : waiting
C1 -> C1 : run Task C while waiting
IO --> C1 : response arrives

@enduml
