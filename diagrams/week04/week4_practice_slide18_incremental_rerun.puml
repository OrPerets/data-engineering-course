@startuml
!include ../_template_styles.puml
!include _week4_visual_style.puml

left to right direction
skinparam nodesep 65
skinparam ranksep 55

database "Control" as CTRL <<store>>
component "Read watermark" as READ <<process>>
database "Source" as SRC <<source>>
component "Extract slice" as EXTRACT <<process>>
component "Transform" as TRANSFORM <<process>>
component "MERGE" as MERGE <<process>>
database "Target" as TGT <<good>>

CTRL -right-> READ
READ -right-> EXTRACT
SRC -down-> EXTRACT
EXTRACT -right-> TRANSFORM
TRANSFORM -right-> MERGE
MERGE -right-> TGT
MERGE -down-> CTRL : update

@enduml
