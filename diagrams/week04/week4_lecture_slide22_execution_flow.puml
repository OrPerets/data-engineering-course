@startuml
!include ../_template_styles.puml
!include _week4_visual_style.puml

left to right direction
skinparam nodesep 70
skinparam ranksep 60

component "Schedule" as TRIGGER <<source>>
component "Read source" as READ <<process>>
component "Transform" as TRANSFORM <<process>>
component "Write target" as WRITE <<process>>
database "Control" as STATE <<store>>

TRIGGER -right-> READ
READ -right-> TRANSFORM
TRANSFORM -right-> WRITE
WRITE -down-> STATE : update
STATE -up-> READ : watermark

@enduml
