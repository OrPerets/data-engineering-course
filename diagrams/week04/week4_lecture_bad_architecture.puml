@startuml
!include ../_template_styles.puml
!include _week4_visual_style.puml

top to bottom direction
skinparam nodesep 70
skinparam ranksep 55

rectangle "Bad" as BAD {
  database "Source" as SRC_BAD <<source>>
  component "INSERT" as INS_BAD <<failure>>
  database "Target" as TGT_BAD <<failure>>
  SRC_BAD -right-> INS_BAD
  INS_BAD -right-> TGT_BAD
}

rectangle "Correct" as OK {
  database "Source" as SRC_OK <<source>>
  component "Extract" as EXT <<process>>
  database "Staging" as STG <<store>>
  component "MERGE" as MERGE <<process>>
  database "Target" as TGT_OK <<good>>
  database "Control" as CTRL <<store>>
  SRC_OK -right-> EXT
  EXT -right-> STG
  STG -right-> MERGE
  MERGE -right-> TGT_OK
  MERGE -down-> CTRL
}

TGT_BAD -[hidden]right- SRC_OK

@enduml
