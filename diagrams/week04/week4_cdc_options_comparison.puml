@startuml
!include ../_template_styles.puml

left to right direction

rectangle "Snapshot" as S {
  card "Simple" as S1
  card "High read cost" as S2
}

rectangle "Timestamp" as T {
  card "Easy to adopt" as T1
  card "Misses deletes\nwithout tombstones" as T2
}

rectangle "Log-based" as L {
  card "Best fidelity" as L1
  card "Higher ops complexity" as L2
}

rectangle "Trigger" as G {
  card "Accurate changes" as G1
  card "Can burden source DB" as G2
}

S -[hidden]right- T
T -[hidden]right- L
L -[hidden]right- G

@enduml
