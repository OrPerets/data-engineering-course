@startuml
!include ../_template_styles.puml
!include _week4_visual_style.puml

top to bottom direction
skinparam nodesep 65
skinparam ranksep 55

rectangle "v1 Full refresh" as V1 {
  database "Source" as S1 <<source>>
  component "Read full" as R1 <<risk>>
  component "INSERT" as I1 <<risk>>
  database "Target" as T1 <<store>>
  S1 -right-> R1
  R1 -right-> I1
  I1 -right-> T1
}

rectangle "v2 Incremental" as V2 {
  database "Source" as S2 <<source>>
  component "Read slice" as R2 <<process>>
  database "Staging" as ST2 <<store>>
  component "MERGE" as M2 <<process>>
  database "Target" as T2 <<good>>
  database "Control" as C2 <<store>>
  S2 -right-> R2
  R2 -right-> ST2
  ST2 -right-> M2
  M2 -right-> T2
  M2 -down-> C2
}

T1 -[hidden]right- S2

@enduml
