@startuml
!include ../_template_styles.puml
!include _week4_visual_style.puml

top to bottom direction
skinparam nodesep 70
skinparam ranksep 55

rectangle "Sources" as SRC {
  database "DB / API" as SRC1 <<source>>
  database "Files" as SRC2 <<source>>
  SRC1 -[hidden]down- SRC2
}

component "Extract" as EXTRACT <<process>>
database "Staging" as STG <<store>>
component "Transform" as TRANSFORM <<process>>
component "Load" as LOAD <<process>>
database "Target" as TGT <<good>>

SRC1 -down-> EXTRACT
SRC2 -down-> EXTRACT
EXTRACT -down-> STG
STG -down-> TRANSFORM
TRANSFORM -down-> LOAD
LOAD -down-> TGT

@enduml
