@startuml
!include ../_template_styles.puml

[*] --> STARTED
STARTED --> VALIDATED : quality pass
VALIDATED --> LOADED : merge/overwrite success
LOADED --> PUBLISHED : checkpoint watermark
STARTED --> FAILED : extractor error
VALIDATED --> FAILED : schema/type failure
LOADED --> FAILED : target write failure
FAILED --> STARTED : rerun from last published watermark

@enduml
