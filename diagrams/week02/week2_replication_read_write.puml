@startuml
!include ../_template_styles.puml

left to right direction
skinparam nodesep 120
skinparam ranksep 90

actor "Client" as C
component "API" as API

database "Leader" as L
database "Replica 1" as R1
database "Replica 2" as R2

C -right-> API : request
API -right-> L : write + strong read

L -[dashed]-> R1 : async replication
L -[dashed]-> R2 : async replication

API -down-> R1 : optional scale reads
API -down-> R2 : optional geo reads

rectangle "Leader read: freshest data" as FRESH
rectangle "Replica read: lower load, may lag" as LAG

L -down-> FRESH
R1 -down-> LAG
R2 -down-> LAG

@enduml
