@startuml
!include ../_template_styles.puml

left to right direction
skinparam nodesep 120
skinparam ranksep 90

actor "Clients" as C
component "App Tier" as APP

database "Single DB Node" as DB

rectangle "Storage Ceiling\nIndexes + data outgrow disk" as S
rectangle "Throughput Ceiling\nCPU and IOPS saturate" as T
rectangle "Availability Risk\nOne maintenance/failure domain" as A <<Failure>>

C -right-> APP : read/write traffic
APP -right-> DB : all requests

DB -up-> S
DB -down-> T
DB -right-> A

@enduml
