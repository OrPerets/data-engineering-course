' Week 02 visual style overrides (inspired by legacy lecture visuals)
skinparam backgroundColor #ECECEC
skinparam shadowing true
skinparam roundcorner 14
skinparam handwritten false
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 65
skinparam defaultFontName "Segoe UI, Arial, sans-serif"
skinparam defaultFontSize 16

skinparam arrow {
  Color #1F1F1F
  Thickness 2.5
  FontColor #1F1F1F
  FontSize 13
}

skinparam package {
  BackgroundColor transparent
  BorderColor transparent
  FontColor #2D2D2D
  FontStyle bold
}

skinparam rectangle {
  BorderColor #4C6E91
  BorderThickness 1.8
  BackgroundColor #FFFFFF
  FontColor #1F1F1F
  RoundCorner 14
}

skinparam component {
  BorderColor #4C6E91
  BorderThickness 1.8
  BackgroundColor #FFFFFF
  FontColor #1F1F1F
  RoundCorner 14
}

skinparam database {
  BorderColor #4C6E91
  BorderThickness 1.8
  BackgroundColor #FFFFFF
  FontColor #1F1F1F
}

