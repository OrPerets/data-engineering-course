@startuml
!include ../_template_styles.puml
!include _week3_visual_style.puml

top to bottom direction
skinparam nodesep 70
skinparam ranksep 55

database "Input" as INP <<store>>
component "Split" as SPLIT <<process>>
rectangle "Map" as MAP_PHASE {
  component "W1" as W1 <<process>>
  component "W2" as W2 <<process>>
  component "W3" as W3 <<process>>
  W1 -[hidden]down- W2
  W2 -[hidden]down- W3
}
component "Shuffle" as SORT_XFER <<process>>
rectangle "Reduce" as REDUCE_PHASE {
  component "R1" as R1 <<process>>
  component "R2" as R2 <<process>>
  R1 -[hidden]down- R2
}
database "Result" as OUT <<store>>

INP -down-> SPLIT
SPLIT -down-> W1
SPLIT -down-> W2
SPLIT -down-> W3
W1 -down-> SORT_XFER
W2 -down-> SORT_XFER
W3 -down-> SORT_XFER
SORT_XFER -down-> R1
SORT_XFER -down-> R2
R1 -down-> OUT
R2 -down-> OUT

@enduml
