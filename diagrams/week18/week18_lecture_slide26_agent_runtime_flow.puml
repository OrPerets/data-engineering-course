@startuml
top to bottom direction
skinparam linetype ortho
skinparam shadowing true
skinparam roundcorner 12
skinparam defaultFontName "Segoe UI, Arial, sans-serif"
skinparam defaultFontSize 18
skinparam defaultFontColor #1A237E
skinparam backgroundColor transparent
skinparam component {
  BackgroundColor #FFFFFF
  BorderColor #5C6BC0
  BorderThickness 2
  FontSize 16
  Padding 14
}
skinparam component<<Gate>> {
  BorderColor #FF6F00
  BackgroundColor #FFF3E0
  FontColor #E65100
  BorderThickness 2.5
}
skinparam component<<Good>> {
  BorderColor #00897B
  BackgroundColor #E0F2F1
  FontColor #004D40
  BorderThickness 2.5
}
skinparam arrow {
  Color #5C6BC0
  Thickness 2
  FontSize 14
  FontColor #3949AB
}

component "1 Request Received" as req
component "2 Input Guardrails" as input <<Gate>>
component "3 Authority Check" as auth <<Gate>>
component "4 Retrieval / Tools" as exec
component "5 HITL Gate\nif required" as hitl <<Gate>>
component "6 Response Synthesis" as response
component "7 Audit Trace Stored" as audit <<Good>>

req --> input
input --> auth
auth --> exec
exec --> hitl
hitl --> response
response --> audit
@enduml
