@startuml
!include ../_template_styles.puml
!include _week5_visual_style.puml

top to bottom direction
skinparam nodesep 70
skinparam ranksep 55

rectangle "Good" as GOOD {
  component "Query\nWHERE date_key" as Q1 <<process>>
  component "Pruning\n31 parts" as PRUNE1 <<process>>
  database "Scan" as S1 <<good>>
  Q1 -down-> PRUNE1
  PRUNE1 -down-> S1
}

rectangle "Bad" as BAD {
  component "Query\nNo filter" as Q2 <<failure>>
  component "Full scan\n365 parts" as FULL <<failure>>
  database "Scan" as S2 <<failure>>
  Q2 -down-> FULL
  FULL -down-> S2
}

S1 -[hidden]right- Q2

@enduml
