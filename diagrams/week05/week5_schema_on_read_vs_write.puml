@startuml
!include ../_template_styles.puml
!include _week5_visual_style.puml

left to right direction
skinparam nodesep 65
skinparam ranksep 55

rectangle "Schema-on-write" as W {
  component "Load\nValidate" as L1 <<process>>
  database "DWH" as DWH <<store>>
  component "Bad row" as R1 <<failure>>
  L1 -right-> DWH
  L1 -down-> R1
}

rectangle "Schema-on-read" as R {
  component "Load raw" as L2 <<process>>
  component "Query" as Q2 <<process>>
  database "Lake" as LAKE <<store>>
  database "DLQ" as DLQ <<failure>>
  L2 -right-> Q2
  Q2 -right-> LAKE
  Q2 -down-> DLQ
}

DWH -[hidden]right- LAKE

@enduml
