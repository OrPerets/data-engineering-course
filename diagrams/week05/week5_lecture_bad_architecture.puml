@startuml
!include ../_template_styles.puml
!include _week5_visual_style.puml

top to bottom direction
skinparam nodesep 70
skinparam ranksep 55

rectangle "Bad" as BAD {
  component "BI Report" as BI_BAD <<failure>>
  component "Query\nNo date_key" as Q_BAD <<failure>>
  database "Fact table" as FACT_BAD <<failure>>
  BI_BAD -down-> Q_BAD
  Q_BAD -down-> FACT_BAD
}

rectangle "Correct" as OK {
  component "BI Report" as BI_OK <<process>>
  component "Query\nWHERE date_key" as Q_OK <<process>>
  component "Pruning" as PRUNE <<process>>
  database "sales_fact" as FACT_OK <<good>>
  BI_OK -down-> Q_OK
  Q_OK -down-> PRUNE
  PRUNE -down-> FACT_OK
}

FACT_BAD -[hidden]right- BI_OK

@enduml
