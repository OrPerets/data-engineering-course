@startuml
!include ../_template_styles.puml
!include _week5_visual_style.puml

top to bottom direction
skinparam nodesep 80
skinparam ranksep 60

rectangle "Sources" as SRC {
  database "DB / Ops" as S1 <<source>>
  database "Files / Logs" as S2 <<source>>
  S1 -[hidden]right- S2
}

component "ETL / ELT" as ETL <<process>>

rectangle "Storage" as STO {
  database "DWH" as DWH <<store>>
  database "Lake" as LAKE <<store>>
  DWH -[hidden]right- LAKE
}

rectangle "Consumers" as CONS {
  component "BI" as BI <<good>>
  component "ML" as ML <<good>>
  BI -[hidden]right- ML
}

S1 -down-> ETL
S2 -down-> ETL
ETL -down-> DWH
ETL -down-> LAKE
DWH -down-> BI
LAKE -down-> ML

@enduml
