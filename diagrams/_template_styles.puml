'=================================================
' TEMPLATE STYLES - DATA ENGINEERING (skinparams only)
' Include from weekXX/*.puml with: !include ../_template_styles.puml
' Palette: 1 = default (neutral), 2 = failure/bad only. Spacing increased for clarity.
'=================================================
skinparam linetype ortho
skinparam shadowing false
skinparam roundcorner 8
skinparam handwritten false

'-------------------------
' SPACING — more room between entities for clearer flow
'-------------------------
skinparam nodesep 140
skinparam ranksep 100

'-------------------------
' FONT & GLOBAL
'-------------------------
skinparam defaultFontName "Segoe UI, Arial, sans-serif"
skinparam defaultFontSize 18
skinparam defaultFontColor #37474F
skinparam backgroundColor transparent

'-------------------------
' PALETTE 1 — DEFAULT (neutral, professional)
' Light grey background, grey-blue border, dark text
'-------------------------
skinparam rectangle {
    BackgroundColor #FAFAFA
    BorderColor #546E7A
    BorderThickness 2
    FontColor #37474F
    FontSize 18
    FontStyle bold
    Padding 20
    RoundCorner 8
}

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #546E7A
    BorderThickness 2
    FontSize 16
    FontColor #37474F
    Padding 16
    RoundCorner 8
}

skinparam database {
    BackgroundColor #FAFAFA
    BorderColor #546E7A
    BorderThickness 2
    FontSize 16
    FontColor #37474F
}

skinparam arrow {
    Color #546E7A
    Thickness 2
    FontSize 14
    FontColor #37474F
}

skinparam package {
    BackgroundColor #F5F5F5
    BorderColor #90A4AE
    BorderThickness 1.5
    FontColor #37474F
    FontSize 14
    FontStyle bold
}

skinparam storage {
    BackgroundColor #FAFAFA
    BorderColor #546E7A
    BorderThickness 2
    FontColor #37474F
}

skinparam cloud {
    BackgroundColor #FAFAFA
    BorderColor #546E7A
    BorderThickness 2
    FontColor #37474F
}

skinparam card {
    BackgroundColor #FAFAFA
    BorderColor #546E7A
    BorderThickness 2
    FontColor #37474F
    Padding 20
    RoundCorner 8
}

'-------------------------
' PALETTE 2 — FAILURE / BAD (semantic only)
'-------------------------
skinparam component<<Bad>> {
    BorderColor #B71C1C
    BackgroundColor #FFEBEE
    FontColor #B71C1C
