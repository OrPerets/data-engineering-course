@startuml
!include ../_template_styles.puml
!include _week1_visual_style.puml

left to right direction
skinparam nodesep 70
skinparam ranksep 60

storage "S3 Logs" as S3 <<source>>
component "Read" as READ <<process>>
component "Parse" as PARSE <<process>>
component "Validate" as VALIDATE <<process>>
component "Write" as WRITE <<process>>
database "Raw" as RAW <<store>>

S3 -right-> READ
READ -right-> PARSE
PARSE -right-> VALIDATE
VALIDATE -right-> WRITE
WRITE -right-> RAW

@enduml
