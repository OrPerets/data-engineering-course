@startuml
!include ../_template_styles.puml
!include _week1_visual_style.puml

top to bottom direction
skinparam nodesep 80
skinparam ranksep 60

storage "Input" as INPUT <<source>>
component "Step 1\nIngest" as STEP1 <<process>>
database "Raw" as RAW <<store>>
component "Step 2\nOOM" as STEP2 <<failure>>
database "Partial" as PARTIAL <<failure>>
component "Step 3" as STEP3 <<risk>>
component "Step 4" as STEP4 <<risk>>
database "Output" as OUTPUT <<risk>>

INPUT -down-> STEP1
STEP1 -down-> RAW
RAW -down-> STEP2
STEP2 -down-> PARTIAL
STEP2 -[dashed]down-> STEP3
STEP3 -[dashed]down-> STEP4
STEP4 -[dashed]down-> OUTPUT

@enduml
