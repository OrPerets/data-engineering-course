@startuml
!include ../_template_styles.puml
!include _week1_visual_style.puml

top to bottom direction
skinparam nodesep 60
skinparam ranksep 50

package "SOURCES" {
  database "News" as NEWS <<source>>
  storage "Clicks" as CLICKS <<source>>
}

package "INGESTION" {
  component "Articles" as INGEST_ART <<process>>
  component "Clicks" as INGEST_CLICK <<process>>
}

package "STORAGE" {
  database "Articles" as RAW_ART <<store>>
  database "Clicks" as RAW_CLICK <<store>>
}

package "PROCESSING" {
  component "Batch" as BATCH <<process>>
  component "Stream" as STREAM <<process>>
}

package "ANALYTICS" {
  database "Warehouse" as WAREHOUSE <<store>>
  cloud "Trending" as TRENDING <<store>>
}

package "CONSUMPTION" {
  component "Analytics" as DASHBOARD <<good>>
  component "App" as APP <<good>>
}

NEWS -down-> INGEST_ART
CLICKS -down-> INGEST_CLICK
INGEST_ART -down-> RAW_ART
INGEST_CLICK -down-> RAW_CLICK
RAW_ART -down-> BATCH
RAW_CLICK -down-> STREAM
BATCH -down-> WAREHOUSE
STREAM -down-> TRENDING
WAREHOUSE -down-> DASHBOARD
TRENDING -down-> APP

@enduml
