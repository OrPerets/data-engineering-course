@startuml
!include ../_template_styles.puml
!include _week1_visual_style.puml

top to bottom direction
skinparam nodesep 70
skinparam ranksep 55

package "SOURCES" {
  storage "Logs" as SOURCE1 <<source>>
  database "Users" as SOURCE2 <<source>>
  database "Products" as SOURCE3 <<source>>
}

package "INGESTION" {
  component "Extract" as INGEST <<process>>
}

package "STORAGE" {
  database "Raw" as RAW <<store>>
}

package "PROCESSING" {
  component "Transform" as TRANSFORM <<process>>
  component "Aggregate" as AGGREGATE <<process>>
}

package "CONSUMPTION" {
  database "Warehouse" as WAREHOUSE <<store>>
  component "Analytics" as DASHBOARD <<good>>
  component "ML" as ML <<good>>
}

SOURCE1 -down-> INGEST
SOURCE2 -down-> INGEST
SOURCE3 -down-> INGEST
INGEST -down-> RAW
RAW -down-> TRANSFORM
TRANSFORM -right-> AGGREGATE
AGGREGATE -down-> WAREHOUSE
WAREHOUSE -right-> DASHBOARD
WAREHOUSE -down-> ML

@enduml
