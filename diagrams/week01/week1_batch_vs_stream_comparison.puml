@startuml
!include ../_template_styles.puml

left to right direction

rectangle "Batch" as B {
  component "Scheduled\nprocessing" as B1
  storage "Large\nwindow" as B2
  card "Latency:\nminutes-hours" as B3
}

rectangle "Streaming" as S {
  component "Continuous\nprocessing" as S1
  queue "Event-by-event\nflow" as S2
  card "Latency:\nseconds" as S3
}

actor "Business SLA" as A
A --> B1 : relaxed freshness
A --> S1 : near real-time

B2 --> B3
S2 --> S3
B3 -[hidden]down- S3

note bottom
Choose by SLA and operational complexity,
not by trend.
end note

@enduml
