@startuml
!include ../_template_styles.puml
!include _week1_visual_style.puml

left to right direction
skinparam nodesep 80
skinparam ranksep 60

rectangle "Schema-on-write" as W <<process>>
database "Gate" as W1 <<store>>
component "Validate" as W2 <<process>>
storage "Curated" as W3 <<store>>

rectangle "Schema-on-read" as R <<decision>>
cloud "Raw" as R1 <<source>>
component "Interpret" as R2 <<process>>
storage "Flexible" as R3 <<store>>

W -right-> W1
W1 -right-> W2
W2 -right-> W3

R -right-> R1
R1 -right-> R2
R2 -right-> R3

W3 -[hidden]down- R1

@enduml
